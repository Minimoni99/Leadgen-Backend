POSTGRES_DB=leadgen
POSTGRES_USER=leadgen
POSTGRES_PASSWORD=leadgen

# Scraper and proxy configuration
SCRAPER_IMAGE=gosom/google-maps-scraper:latest
SCRAPER_OUTPUT_DIR=output
SCRAPER_DEPTH=1
SCRAPER_CONCURRENCY=2
SCRAPER_EMAIL=true
SCRAPER_EXIT_INACTIVITY=3m

# Proxy options (one option only)
# Option A: single proxy URL
# PROXY_PROTOCOL=http
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8000
# PROXY_USER=user
# PROXY_PASS=pass

# Option B: comma-separated proxies list
# PROXIES=http://user:pass@proxy1:8000,socks5://user:pass@proxy2:1080

# Option C: proxies file path
# PROXY_FILE=proxies.txt
